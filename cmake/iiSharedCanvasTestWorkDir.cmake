# Resolve an existing private test workspace under the canonical resource tree.
function(iisc_test_work_dir output resource_root requested)
    if(NOT IS_ABSOLUTE "${resource_root}" OR NOT IS_DIRECTORY "${resource_root}")
        message(FATAL_ERROR "Test resource root must be an existing absolute directory")
    endif()
    if(NOT IS_ABSOLUTE "${requested}" OR NOT IS_DIRECTORY "${requested}" OR
       IS_SYMLINK "${requested}" OR "${requested}" MATCHES "[;\"\r\n]")
        message(FATAL_ERROR "Test work directory must be an existing absolute directory")
    endif()
    file(REAL_PATH "${resource_root}" root)
    file(REAL_PATH "${requested}" work)
    cmake_path(IS_PREFIX root "${work}" NORMALIZE inside)
    if(NOT inside OR work STREQUAL root)
        message(FATAL_ERROR "Test work directory must be inside the resource root")
    endif()
    cmake_path(RELATIVE_PATH work BASE_DIRECTORY "${root}" OUTPUT_VARIABLE relative)
    if(NOT relative MATCHES "^\\.iisacc-[^/]+(/|$)")
        message(FATAL_ERROR "Test work directory must use the reserved .iisacc- prefix")
    endif()
    set(${output} "${work}" PARENT_SCOPE)
endfunction()

# Allocate a private resource work directory once per CMake build cache.
function(iisc_configure_test_work_dir output resource_root)
    if(NOT IS_ABSOLUTE "${resource_root}" OR NOT IS_DIRECTORY "${resource_root}")
        message(FATAL_ERROR "Test resource root must be an existing absolute directory")
    endif()
    file(REAL_PATH "${resource_root}" _resource_root)
    set(IISC_TEST_WORK_DIR "" CACHE PATH "Existing private test directory below resources/")
    set(_generate FALSE)
    if(IISC_TEST_WORK_DIR STREQUAL "")
        set(_generate TRUE)
    elseif(DEFINED _IISC_GENERATED_TEST_WORK_DIR AND
           "${IISC_TEST_WORK_DIR}" STREQUAL "${_IISC_GENERATED_TEST_WORK_DIR}" AND
           NOT EXISTS "${IISC_TEST_WORK_DIR}" AND NOT IS_SYMLINK "${IISC_TEST_WORK_DIR}")
        # A successful run may have removed its own generated workspace.
        set(_generate TRUE)
    endif()
    if(_generate)
        string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef _nonce)
        set(_private "${_resource_root}/.iisacc-tests-${_nonce}")
        if(EXISTS "${_private}" OR IS_SYMLINK "${_private}")
            message(FATAL_ERROR "Refusing an existing generated test work directory")
        endif()
        file(MAKE_DIRECTORY "${_private}")
        set(IISC_TEST_WORK_DIR "${_private}" CACHE PATH "Existing private test directory below resources/" FORCE)
        set(_IISC_GENERATED_TEST_WORK_DIR "${_private}" CACHE INTERNAL "Automatically generated test work directory" FORCE)
    endif()
    iisc_test_work_dir(_checked "${_resource_root}" "${IISC_TEST_WORK_DIR}")
    set(${output} "${_checked}" PARENT_SCOPE)
endfunction()
