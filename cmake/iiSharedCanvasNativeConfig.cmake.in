@PACKAGE_INIT@
if(EMSCRIPTEN)
    # Emscripten supports side modules although its CMake toolchain defaults
    # the shared-library capability to false.
    set_property(GLOBAL PROPERTY TARGET_SUPPORTS_SHARED_LIBS TRUE)
endif()
set_and_check(iiSharedCanvasNative_RESOURCE_DIR "@PACKAGE_CMAKE_INSTALL_DATADIR@/iiSharedCanvas/resources")
include(CMakeFindDependencyMacro)
find_dependency(iiFileProviderNative 0.11.1 CONFIG)
find_dependency(iiPaintEngine 0.5.4 CONFIG)
find_dependency(iiSDKCore 0.18 CONFIG COMPONENTS Contracts)


find_dependency(iiFileProviderCompatibility 0.9 CONFIG)
find_dependency(iiImageCodec 0.1 CONFIG)
find_dependency(LibXml2)
find_dependency(ZLIB)
include("${CMAKE_CURRENT_LIST_DIR}/iiSharedCanvasNativeTargets.cmake")

if(NOT TARGET iiSharedCanvas::Core)
    add_library(iiSharedCanvas::Core ALIAS iiSharedCanvas::Native)
endif()
