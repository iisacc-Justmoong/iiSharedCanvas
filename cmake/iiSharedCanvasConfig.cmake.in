@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(iiFileProvider 0.6 CONFIG HINTS "$ENV{IIFILEPROVIDER_PREFIX}" "$ENV{HOME}/.local/SDK/iiFileProvider")




get_filename_component(_iiSharedCanvasSiblingPaintEngine
        "${PACKAGE_PREFIX_DIR}/../iiPaintEngine" ABSOLUTE)
if(EXISTS "${_iiSharedCanvasSiblingPaintEngine}")
    list(PREPEND CMAKE_PREFIX_PATH "${_iiSharedCanvasSiblingPaintEngine}")
endif()
if(EXISTS "$ENV{HOME}/.local/SDK/iiPaintEngine")
    list(PREPEND CMAKE_PREFIX_PATH "$ENV{HOME}/.local/SDK/iiPaintEngine")
endif()

list(PREPEND CMAKE_PREFIX_PATH "${PACKAGE_PREFIX_DIR}/../iiFileProvider" "$ENV{HOME}/.local/SDK/iiFileProvider")
find_dependency(iiPaintEngine 0.4.1 CONFIG REQUIRED)
find_dependency(iiFileProvider 0.5.0 CONFIG REQUIRED)
find_dependency(Qt6 6.8.3 EXACT COMPONENTS Core Gui REQUIRED)
set(iiSharedCanvas_Core_FOUND TRUE)
set(iiSharedCanvas_Quick_FOUND @IISHAREDCANVAS_BUILD_QUICK@)
if(NOT iiSharedCanvas_FIND_COMPONENTS OR "Quick" IN_LIST iiSharedCanvas_FIND_COMPONENTS)
    if(iiSharedCanvas_Quick_FOUND)
        find_dependency(Qt6 6.8.3 EXACT COMPONENTS Qml Quick REQUIRED)
    endif()
endif()
find_dependency(ZLIB 1.2.9 REQUIRED)
find_dependency(libzip 1.7.3 CONFIG REQUIRED)
include("${CMAKE_CURRENT_LIST_DIR}/iiSharedCanvasAppleQtCompatibility.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/iiSharedCanvasTargets.cmake")

# LIBRARY_PATH can make this package an implicit linker directory, but dyld
# still needs its directory to resolve the library's @rpath install name.
if(CMAKE_SYSTEM_NAME STREQUAL "Darwin" AND TARGET iiSharedCanvas::iiSharedCanvas)
    get_filename_component(_iiSharedCanvasLibraryDirectory
            "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
    list(FIND CMAKE_CXX_IMPLICIT_LINK_DIRECTORIES
            "${_iiSharedCanvasLibraryDirectory}" _iiSharedCanvasImplicitDirectoryIndex)
    if(NOT _iiSharedCanvasImplicitDirectoryIndex EQUAL -1)
        set_property(TARGET iiSharedCanvas::iiSharedCanvas APPEND PROPERTY
                INTERFACE_LINK_OPTIONS "LINKER:-rpath,${_iiSharedCanvasLibraryDirectory}")
    endif()
    unset(_iiSharedCanvasLibraryDirectory)
    unset(_iiSharedCanvasImplicitDirectoryIndex)
endif()
check_required_components(iiSharedCanvas)

unset(_iiSharedCanvasSiblingPaintEngine)
