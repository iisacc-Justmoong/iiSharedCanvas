if(NOT DEFINED CLI OR NOT DEFINED DRIVER OR NOT DEFINED WORK)
    message(FATAL_ERROR "CLI, DRIVER and WORK are required")
endif()
file(MAKE_DIRECTORY "${WORK}")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(dir "${WORK}/${nonce}")
file(MAKE_DIRECTORY "${dir}")
execute_process(COMMAND "${CLI}" --help RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "timeline CLI help failed")
endif()
foreach(arguments IN ITEMS "--unknown" "--name")
    execute_process(COMMAND "${CLI}" "${arguments}" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
    if(NOT result EQUAL 2)
        message(FATAL_ERROR "invalid timeline arguments must exit 2")
    endif()
endforeach()
execute_process(COMMAND "${DRIVER}" --create "${dir}/-원본.iisc" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "cannot create snapshot fixture")
endif()
file(SHA256 "${dir}/-원본.iisc" original)
execute_process(COMMAND "${CLI}" --name "장면 & test" -- -원본.iisc -내보내기
    WORKING_DIRECTORY "${dir}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "snapshot timeline export failed: ${output} ${error}")
endif()
foreach(file IN ITEMS timeline.xml timeline.fcpxml manifest.json source.iisc)
    if(NOT EXISTS "${dir}/-내보내기/${file}")
        message(FATAL_ERROR "package lacks ${file}")
    endif()
endforeach()
file(READ "${dir}/-내보내기/manifest.json" manifest)
string(JSON name GET "${manifest}" sequenceName)
if(NOT name STREQUAL "장면 & test")
    message(FATAL_ERROR "sequence name was not preserved")
endif()
execute_process(COMMAND "${CLI}" -- -원본.iisc -내보내기
    WORKING_DIRECTORY "${dir}" RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
if(NOT result EQUAL 1 OR NOT error MATCHES "AlreadyExists")
    message(FATAL_ERROR "timeline CLI must reject existing destinations")
endif()
execute_process(COMMAND "${CLI}" -- -원본.iisc missing/output
    WORKING_DIRECTORY "${dir}" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(NOT result EQUAL 1 OR EXISTS "${dir}/missing")
    message(FATAL_ERROR "timeline CLI must not create missing parents")
endif()
execute_process(COMMAND "${DRIVER}" --create-working "${dir}/working.iisc" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "cannot create working-file fixture")
endif()
file(SHA256 "${dir}/working.iisc" working_before)
execute_process(COMMAND "${CLI}" working.iisc working-output/
    WORKING_DIRECTORY "${dir}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "working-file timeline export failed: ${output} ${error}")
endif()
file(SHA256 "${dir}/working.iisc" working_after)
file(SHA256 "${dir}/-원본.iisc" after)
if(NOT original STREQUAL after OR NOT working_before STREQUAL working_after)
    message(FATAL_ERROR "timeline export modified a source file")
endif()
file(REMOVE_RECURSE "${dir}")
