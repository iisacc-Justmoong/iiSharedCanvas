if(NOT DEFINED IMPORTER OR NOT DEFINED EXPORTER OR NOT DEFINED DRIVER OR NOT DEFINED WORK)
    message(FATAL_ERROR "IMPORTER, EXPORTER, DRIVER and WORK are required")
endif()
file(MAKE_DIRECTORY "${WORK}")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(dir "${WORK}/${nonce}")
file(MAKE_DIRECTORY "${dir}")
foreach(cli IN ITEMS "${IMPORTER}" "${EXPORTER}")
    execute_process(COMMAND "${cli}" --help RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "layered CLI help failed: ${cli}")
    endif()
    execute_process(COMMAND "${cli}" --unknown RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
    if(NOT result EQUAL 2)
        message(FATAL_ERROR "layered CLI argument error must exit 2: ${cli}")
    endif()
endforeach()
execute_process(COMMAND "${DRIVER}" --create "${dir}/-원본.iisc" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "could not create layered CLI fixture")
endif()
file(SHA256 "${dir}/-원본.iisc" original)
execute_process(COMMAND "${EXPORTER}" -- -원본.iisc artwork.psd
    WORKING_DIRECTORY "${dir}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "PSD export failed: ${output} ${error}")
endif()
file(CREATE_LINK "${dir}/-원본.iisc" "${dir}/source-link.iisc" SYMBOLIC RESULT link_result)
if(UNIX AND NOT link_result STREQUAL "0")
    message(FATAL_ERROR "could not create the source symbolic-link fixture: ${link_result}")
endif()
if(link_result STREQUAL "0")
    execute_process(COMMAND "${EXPORTER}" source-link.iisc from-link.psd
        WORKING_DIRECTORY "${dir}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "PSD export through an input symbolic link failed: ${output} ${error}")
    endif()
endif()
execute_process(COMMAND "${EXPORTER}" -- -원본.iisc artwork.psd
    WORKING_DIRECTORY "${dir}" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(NOT result EQUAL 1)
    message(FATAL_ERROR "PSD export must reject an existing destination")
endif()
file(CREATE_LINK "${dir}/artwork.psd" "${dir}/output-link.psd" SYMBOLIC RESULT link_result)
if(UNIX AND NOT link_result STREQUAL "0")
    message(FATAL_ERROR "could not create the output symbolic-link fixture: ${link_result}")
endif()
if(link_result STREQUAL "0")
    execute_process(COMMAND "${EXPORTER}" -- -원본.iisc output-link.psd
        WORKING_DIRECTORY "${dir}" RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
    if(NOT result EQUAL 1 OR NOT error MATCHES "AlreadyExists")
        message(FATAL_ERROR "PSD export must report an existing output symbolic link")
    endif()
    execute_process(COMMAND "${EXPORTER}" --overwrite -- -원본.iisc output-link.psd
        WORKING_DIRECTORY "${dir}" RESULT_VARIABLE result OUTPUT_QUIET ERROR_VARIABLE error)
    if(NOT result EQUAL 1 OR NOT error MATCHES "InvalidArgument")
        message(FATAL_ERROR "PSD overwrite must reject an output symbolic link")
    endif()
endif()
execute_process(COMMAND "${EXPORTER}" --overwrite -- -원본.iisc artwork.psd
    WORKING_DIRECTORY "${dir}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "explicit PSD overwrite failed: ${output} ${error}")
endif()
execute_process(COMMAND "${IMPORTER}" --id-prefix=custom -- artwork.psd imported.iisc
    WORKING_DIRECTORY "${dir}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "PSD import failed: ${output} ${error}")
endif()
execute_process(COMMAND "${DRIVER}" --verify-import "${dir}/imported.iisc" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "imported canvas lost expected pixels or layer name")
endif()
execute_process(COMMAND "${DRIVER}" --create-working "${dir}/working.iisc" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "could not create working-file CLI fixture")
endif()
file(SHA256 "${dir}/working.iisc" working_before)
execute_process(COMMAND "${EXPORTER}" working.iisc working.psd
    WORKING_DIRECTORY "${dir}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "PSD export from a working file failed: ${output} ${error}")
endif()
file(SHA256 "${dir}/working.iisc" working_after)
if(NOT working_before STREQUAL working_after)
    message(FATAL_ERROR "PSD export modified its working-file source")
endif()
execute_process(COMMAND "${IMPORTER}" artwork.psd imported.iisc
    WORKING_DIRECTORY "${dir}" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(NOT result EQUAL 1)
    message(FATAL_ERROR "layered import must reject an existing destination")
endif()
execute_process(COMMAND "${IMPORTER}" artwork.psd invalid.png
    WORKING_DIRECTORY "${dir}" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(NOT result EQUAL 2)
    message(FATAL_ERROR "layered import must reject a non-IISC output name")
endif()
execute_process(COMMAND "${IMPORTER}" artwork.psd missing/child.iisc
    WORKING_DIRECTORY "${dir}" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(NOT result EQUAL 1 OR EXISTS "${dir}/missing")
    message(FATAL_ERROR "layered import must not create a missing parent directory")
endif()
file(CREATE_LINK "${dir}/-원본.iisc" "${dir}/alias.psd" RESULT link_result)
if(UNIX AND NOT link_result STREQUAL "0")
    message(FATAL_ERROR "could not create the source hard-link fixture: ${link_result}")
endif()
if(link_result STREQUAL "0")
    execute_process(COMMAND "${EXPORTER}" --overwrite -- -원본.iisc alias.psd
        WORKING_DIRECTORY "${dir}" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
    if(NOT result EQUAL 1)
        message(FATAL_ERROR "PSD export must reject a hard-link alias of its source")
    endif()
endif()
file(SHA256 "${dir}/-원본.iisc" after)
if(NOT original STREQUAL after)
    message(FATAL_ERROR "layered CLI modified its source canvas")
endif()
file(REMOVE_RECURSE "${dir}")
