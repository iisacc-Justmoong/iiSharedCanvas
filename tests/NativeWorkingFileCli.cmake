file(MAKE_DIRECTORY "${WORK}")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(dir "${WORK}/${nonce}")
if(EXISTS "${dir}" OR IS_SYMLINK "${dir}")
    message(FATAL_ERROR "working-file test directory already exists")
endif()
file(MAKE_DIRECTORY "${dir}")
set(path "${dir}/에이전트 작업 파일.iisc")
set(bad "${dir}/corrupt.iisc")
execute_process(COMMAND "${DRIVER}" --legacy-fixture "${path}" RESULT_VARIABLE code)
if(NOT code EQUAL 0)
    message(FATAL_ERROR "legacy fixture creation failed: ${code}")
endif()
file(SHA256 "${path}" original)

function(call expected)
    execute_process(COMMAND "${CLI}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE errors)
    if(NOT code EQUAL expected)
        message(FATAL_ERROR "CLI returned ${code}, expected ${expected}: ${output} ${errors}")
    endif()
    string(JSON schema GET "${output}" schemaVersion)
    if(NOT schema EQUAL 1)
        message(FATAL_ERROR "invalid CLI schema: ${output}")
    endif()
    set(json "${output}" PARENT_SCOPE)
endfunction()
function(expect key expected)
    string(JSON value GET "${json}" "${key}")
    if(NOT "${value}" STREQUAL "${expected}")
        message(FATAL_ERROR "${key}=${value}, expected ${expected}: ${json}")
    endif()
endfunction()
function(unchanged)
    file(SHA256 "${path}" current)
    if(NOT current STREQUAL original)
        message(FATAL_ERROR "read-only CLI changed source bytes")
    endif()
endfunction()

call(0 inspect "${path}")
expect(ok ON)
expect(storageVersion 1)
expect(verified OFF)
unchanged()
call(0 verify "${path}")
expect(verified ON)
unchanged()
call(0 verify "${path}" --snapshot-timeout-ms 60000)
expect(verified ON)
unchanged()
call(0 upgrade-storage "${path}" --snapshot-timeout-ms 60000 --dry-run)
expect(dryRun ON)
expect(verified ON)
unchanged()
call(2 verify "${path}" --snapshot-timeout-ms 0)
call(2 verify "${path}" --snapshot-timeout-ms -1)
call(2 verify "${path}" --snapshot-timeout-ms 2147483648)
call(2 inspect "${path}" --snapshot-timeout-ms 100)
call(2 upgrade-storage "${path}" --snapshot-timeout-ms 100)
unchanged()
if(UNIX)
    set(real_temp "${dir}/real-temp")
    set(alias_temp "${dir}/temp-alias")
    file(MAKE_DIRECTORY "${real_temp}")
    file(CREATE_LINK "${real_temp}" "${alias_temp}" SYMBOLIC)
    set(previous_temp "$ENV{TMPDIR}")
    set(ENV{TMPDIR} "${alias_temp}")
    call(0 verify "${path}")
    expect(verified ON)
    unchanged()
    set(ENV{TMPDIR} "${previous_temp}")
endif()
call(1 verify "${path}" --maximum-bytes 64)
expect(ok OFF)
unchanged()
call(0 upgrade-storage "${path}" --dry-run)
expect(dryRun ON)
expect(wouldChange ON)
expect(changed OFF)
expect(storageVersion 1)
unchanged()
call(0 upgrade-storage "${path}")
expect(changed ON)
expect(storageVersion 2)
expect(revision 1)
call(0 upgrade-storage "${path}")
expect(changed OFF)
call(0 verify "${path}")
expect(verified ON)
execute_process(COMMAND "${DRIVER}" --bad-fixture "${bad}" RESULT_VARIABLE code)
if(NOT code EQUAL 0)
    message(FATAL_ERROR "bad fixture creation failed")
endif()
file(SHA256 "${bad}" before)
call(0 inspect "${bad}")
expect(verified OFF)
call(1 verify "${bad}")
expect(ok OFF)
call(1 upgrade-storage "${bad}" --dry-run)
expect(changed OFF)
call(1 upgrade-storage "${bad}")
expect(changed OFF)
file(SHA256 "${bad}" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "corrupt source was modified")
endif()
call(2 unknown "${path}")
expect(ok OFF)
set(escaped "line\nbreak\"quote")
call(2 unknown "${escaped}")
expect(path "${escaped}")
message(STATUS "NATIVE_WORKING_CLI_OK readonly=true json=true upgrade=true dry_run=true corruption=true")
file(REMOVE_RECURSE "${dir}")
