if(PROBE)
    include("${HELPER}")
    iisc_test_work_dir(resolved "${ROOT}" "${REQUEST}")
    message(STATUS "TEST_WORK_DIR_RESOLVED=${resolved}")
    return()
endif()
if(DEFAULT_PROBE)
    include("${HELPER}")
    iisc_configure_test_work_dir(first "${ROOT}")
    iisc_configure_test_work_dir(second "${ROOT}")
    if(NOT first STREQUAL second OR NOT IS_DIRECTORY "${first}")
        message(FATAL_ERROR "Generated work directory was not retained")
    endif()
    file(REMOVE_RECURSE "${first}")
    iisc_configure_test_work_dir(third "${ROOT}")
    if(NOT IS_DIRECTORY "${third}" OR first STREQUAL third)
        message(FATAL_ERROR "Cleaned generated work directory was not replaced")
    endif()
    message(STATUS "TEST_WORK_DIR_DEFAULT_OK=${first}")
    return()
endif()
if(EXPLICIT_MISSING_PROBE)
    include("${HELPER}")
    set(IISC_TEST_WORK_DIR "${ROOT}/.iisacc-explicit-missing" CACHE PATH "" FORCE)
    iisc_configure_test_work_dir(unexpected "${ROOT}")
    message(FATAL_ERROR "Missing explicitly selected directory was accepted")
endif()
if(CLEANUP_SYMLINK_PROBE)
    include("${HELPER}")
    iisc_configure_test_work_dir(first "${ROOT}")
    file(REMOVE_RECURSE "${first}")
    file(CREATE_LINK "${OUTSIDE}" "${first}" SYMBOLIC RESULT link_result)
    if(NOT link_result STREQUAL "0")
        message(STATUS "TEST_WORK_DIR_SYMLINK_UNAVAILABLE")
        return()
    endif()
    file(WRITE "${ROOT}/generated-link-path" "${first}")
    iisc_configure_test_work_dir(unexpected "${ROOT}")
    message(FATAL_ERROR "A substituted generated directory link was accepted")
endif()

if(NOT DEFINED SOURCE OR NOT DEFINED WORK_DIR OR NOT IS_DIRECTORY "${WORK_DIR}")
    message(FATAL_ERROR "SOURCE and an existing WORK_DIR are required")
endif()
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef nonce)
set(fixture "${WORK_DIR}/work-dir-contract-${nonce}")
if(EXISTS "${fixture}" OR IS_SYMLINK "${fixture}")
    message(FATAL_ERROR "Refusing an existing fixture")
endif()
set(root "${fixture}/resources")
set(valid "${root}/.iisacc-valid")
set(outside "${fixture}/outside")
file(MAKE_DIRECTORY "${valid}/nested" "${root}/.iisacc-한글 space &" "${root}/plain" "${outside}/child")
file(CREATE_LINK "${outside}" "${root}/.iisacc-escape" SYMBOLIC RESULT link_result)
file(CREATE_LINK "${outside}" "${valid}/escape" SYMBOLIC RESULT nested_link_result)

function(check_case label requested should_pass)
    execute_process(COMMAND "${CMAKE_COMMAND}" -DPROBE=ON
        "-DHELPER=${SOURCE}/cmake/iiSharedCanvasTestWorkDir.cmake"
        "-DROOT=${root}" "-DREQUEST=${requested}"
        -P "${CMAKE_CURRENT_LIST_FILE}"
        RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(should_pass AND (NOT result EQUAL 0 OR NOT out MATCHES "TEST_WORK_DIR_RESOLVED="))
        message(FATAL_ERROR "${label} should pass: ${result} ${out} ${err}")
    elseif(NOT should_pass AND result EQUAL 0)
        message(FATAL_ERROR "${label} should be rejected")
    endif()
endfunction()

check_case(valid "${valid}" TRUE)
check_case(nested_valid "${valid}/nested" TRUE)
check_case(unicode_and_spaces "${root}/.iisacc-한글 space &" TRUE)
execute_process(COMMAND "${CMAKE_COMMAND}" -DDEFAULT_PROBE=ON
    "-DHELPER=${SOURCE}/cmake/iiSharedCanvasTestWorkDir.cmake" "-DROOT=${root}"
    -P "${CMAKE_CURRENT_LIST_FILE}"
    RESULT_VARIABLE default_result OUTPUT_VARIABLE default_out ERROR_VARIABLE default_err)
if(NOT default_result EQUAL 0 OR NOT default_out MATCHES "TEST_WORK_DIR_DEFAULT_OK=")
    message(FATAL_ERROR "Generated work directory failed: ${default_result} ${default_out} ${default_err}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -DEXPLICIT_MISSING_PROBE=ON
    "-DHELPER=${SOURCE}/cmake/iiSharedCanvasTestWorkDir.cmake" "-DROOT=${root}"
    -P "${CMAKE_CURRENT_LIST_FILE}"
    RESULT_VARIABLE explicit_result OUTPUT_VARIABLE explicit_out ERROR_VARIABLE explicit_err)
if(explicit_result EQUAL 0 OR NOT explicit_err MATCHES "Test work directory must be an existing absolute directory")
    message(FATAL_ERROR "Missing explicitly selected directory should be rejected: ${explicit_out} ${explicit_err}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -DCLEANUP_SYMLINK_PROBE=ON
    "-DHELPER=${SOURCE}/cmake/iiSharedCanvasTestWorkDir.cmake" "-DROOT=${root}" "-DOUTSIDE=${outside}"
    -P "${CMAKE_CURRENT_LIST_FILE}"
    RESULT_VARIABLE link_probe_result OUTPUT_VARIABLE link_probe_out ERROR_VARIABLE link_probe_err)
if(NOT link_probe_out MATCHES "TEST_WORK_DIR_SYMLINK_UNAVAILABLE")
    if(link_probe_result EQUAL 0 OR NOT link_probe_err MATCHES "Test work directory must be an existing absolute directory")
        message(FATAL_ERROR "Substituted generated directory link was not rejected: ${link_probe_out} ${link_probe_err}")
    endif()
    file(READ "${root}/generated-link-path" generated_link)
    if(NOT IS_SYMLINK "${generated_link}" OR NOT IS_DIRECTORY "${outside}")
        message(FATAL_ERROR "Rejected generated directory link or target was removed")
    endif()
endif()
check_case(resource_root "${root}" FALSE)
check_case(outside "${outside}" FALSE)
check_case(unreserved "${root}/plain" FALSE)
check_case(missing "${root}/.iisacc-missing" FALSE)
check_case(relative "relative/path" FALSE)
if(link_result STREQUAL "0")
    check_case(symlink_escape "${root}/.iisacc-escape" FALSE)
endif()
if(nested_link_result STREQUAL "0")
    check_case(nested_symlink_escape "${valid}/escape/child" FALSE)
endif()
if(DEFINED BUILD_ROOT)
    include("${SOURCE}/tests/NativeTestWorkDirReconfigure.cmake")
endif()
file(REMOVE_RECURSE "${fixture}")
message(STATUS "TEST_WORK_DIR_CONTRACT_OK")
