if(NOT DEFINED CLI OR NOT DEFINED DRIVER OR NOT DEFINED WORK)
    message(FATAL_ERROR "CLI, DRIVER and WORK are required")
endif()
file(MAKE_DIRECTORY "${WORK}")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(dir "${WORK}/${nonce}")
file(MAKE_DIRECTORY "${dir}")
execute_process(COMMAND "${CLI}" --help RESULT_VARIABLE result OUTPUT_VARIABLE help)
if(NOT result EQUAL 0 OR NOT help MATCHES "Usage: iisc-upgrade")
    message(FATAL_ERROR "upgrade CLI help failed")
endif()
execute_process(COMMAND "${CLI}" --unknown RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(NOT result EQUAL 2)
    message(FATAL_ERROR "upgrade CLI argument failure must exit 2")
endif()
execute_process(COMMAND "${DRIVER}" --create "${dir}/-원본.iisc" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "could not create upgrade CLI fixture")
endif()
file(SHA256 "${dir}/-원본.iisc" before)
execute_process(COMMAND "${CLI}" -- -원본.iisc output.iisc
    WORKING_DIRECTORY "${dir}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "upgrade CLI failed: ${output} ${error}")
endif()
file(SHA256 "${dir}/-원본.iisc" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "upgrade CLI modified an explicit-output source")
endif()
execute_process(COMMAND "${DRIVER}" --verify "${dir}/output.iisc" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "upgrade CLI output failed document verification")
endif()
execute_process(COMMAND "${CLI}" -- -원본.iisc output.iisc
    WORKING_DIRECTORY "${dir}" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(NOT result EQUAL 1)
    message(FATAL_ERROR "upgrade CLI must reject an existing destination")
endif()
execute_process(COMMAND "${CLI}" output.iisc WORKING_DIRECTORY "${dir}"
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "current in-place upgrade failed")
endif()
file(REMOVE_RECURSE "${dir}")
