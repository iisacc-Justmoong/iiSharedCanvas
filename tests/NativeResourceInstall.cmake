# Verify a staged install owns its resources, even when the source root is a link.
foreach(_name IN ITEMS SDK_BUILD RESOURCE_SOURCE INSTALL_DATADIR OUTPUT_ROOT)
    if(NOT DEFINED ${_name} OR "${${_name}}" STREQUAL "")
        message(FATAL_ERROR "Missing ${_name}")
    endif()
endforeach()
string(REPLACE "\\" "/" _datadir "${INSTALL_DATADIR}")
if(IS_ABSOLUTE "${_datadir}" OR _datadir MATCHES "(^|/)\\.\\.(/|$)")
    message("SKIP: Resource install test requires a relative install data directory")
    return()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/iiSharedCanvasTestWorkDir.cmake")
iisc_test_work_dir(_root "${RESOURCE_SOURCE}" "${OUTPUT_ROOT}")
string(RANDOM LENGTH 24 ALPHABET abcdef0123456789 _nonce)
set(_prefix "${_root}/resource-install-${_nonce}")
if(EXISTS "${_prefix}" OR IS_SYMLINK "${_prefix}")
    message(FATAL_ERROR "Refusing to reuse a test installation directory")
endif()
set(_command "${CMAKE_COMMAND}" --install "${SDK_BUILD}" --prefix "${_prefix}")
if(DEFINED CONFIGURATION AND NOT "${CONFIGURATION}" STREQUAL "")
    list(APPEND _command --config "${CONFIGURATION}")
endif()
execute_process(COMMAND ${_command} RESULT_VARIABLE _result OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
if(NOT _result EQUAL 0)
    message(FATAL_ERROR "Staged SDK installation failed: ${_out}\n${_err}")
endif()
set(_installed "${_prefix}/${_datadir}/iiSharedCanvas/resources")
if(NOT IS_DIRECTORY "${_installed}" OR IS_SYMLINK "${_installed}")
    message(FATAL_ERROR "Installed resources are missing or are a source-directory link: ${_installed}")
endif()
file(GLOB_RECURSE _installed_relative LIST_DIRECTORIES TRUE RELATIVE "${_installed}" "${_installed}/*")
foreach(_entry IN LISTS _installed_relative)
    if(_entry MATCHES "(^|/)\\.iisacc-[^/]+(/|$)")
        message(FATAL_ERROR "Private test work must not be installed as a resource: ${_entry}")
    endif()
endforeach()
file(GLOB_RECURSE _files LIST_DIRECTORIES FALSE RELATIVE "${RESOURCE_SOURCE}" "${RESOURCE_SOURCE}/*")
list(FILTER _files EXCLUDE REGEX "(^|/)\\.iisacc-[^/]+(/|$)")
if(NOT _files)
    message(FATAL_ERROR "Resource fixture is empty")
endif()
foreach(_file IN LISTS _files)
    set(_target "${_installed}/${_file}")
    if(NOT EXISTS "${_target}")
        message(FATAL_ERROR "Missing installed resource: ${_file}")
    endif()
    file(REAL_PATH "${_target}" _resolved)
    cmake_path(IS_PREFIX _prefix "${_resolved}" NORMALIZE _inside)
    if(NOT _inside)
        message(FATAL_ERROR "Installed resource escapes its prefix: ${_file}")
    endif()
    file(SHA256 "${RESOURCE_SOURCE}/${_file}" _expected)
    file(SHA256 "${_target}" _actual)
    if(NOT _expected STREQUAL _actual)
        message(FATAL_ERROR "Installed resource differs: ${_file}")
    endif()
endforeach()
file(GLOB_RECURSE _installed_entries LIST_DIRECTORIES TRUE "${_installed}/*")
foreach(_entry IN LISTS _installed_entries)
    if(IS_SYMLINK "${_entry}")
        file(REAL_PATH "${_entry}" _resolved)
        cmake_path(IS_PREFIX _prefix "${_resolved}" NORMALIZE _inside)
        if(NOT _inside)
            message(FATAL_ERROR "Installed resource link escapes its prefix: ${_entry}")
        endif()
    endif()
endforeach()
list(LENGTH _files _count)
file(REMOVE_RECURSE "${_prefix}")
message(STATUS "RESOURCE_INSTALL_OK files=${_count} self_contained=true")
